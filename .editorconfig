root = true

# LF everywhere: CI runs on Linux, and PowerShell 5.1+ on Windows reads
# LF-terminated scripts without issue. .gitattributes enforces this at the
# git level; this file keeps editors in line.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false
